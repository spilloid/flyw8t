# Copy to .env and replace every value. .env is git-ignored.
FLYW8T_DB_PASSWORD=replace-with-a-long-random-password
FLYW8T_PUBLIC_URL=http://localhost:8080
# Used only while no users exist; remove after the first sign-in.
FLYW8T_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FLYW8T_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-or-more-characters
# Native TLS (paths inside the container; put files in deploy/compose/tls/):
# FLYW8T_TLS_CERT=/tls/fullchain.pem
# FLYW8T_TLS_KEY=/tls/privkey.pem
# FLYW8T_PUBLIC_URL=https://rmm.example.com:8443
# FLYW8T_PUBLISH=0.0.0.0:8443

# Cloudflare Tunnel (docker compose --profile tunnel up -d). TLS ends at Cloudflare:
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...            # from Zero Trust > Networks > Tunnels
# FLYW8T_PUBLIC_URL=https://rmm.example.com # the tunnel's public hostname
# FLYW8T_TRUSTED_PROXIES=172.29.0.10        # the tunnel container; believe its client address
